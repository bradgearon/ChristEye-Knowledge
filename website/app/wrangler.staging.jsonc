{
  "name": "anaiero",
  "compatibility_date": "2026-11-15",
  "main": "./worker/index.js",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "ALLOWED_HOSTNAMES": "anaiero.bradgearon.workers.dev"
  }
}
