{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "previous",
    "payload",
    "entry_hash"
  ],
  "properties": {
    "previous": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object"
    },
    "entry_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
