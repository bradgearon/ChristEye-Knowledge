{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:christeye:software:bread_meat_plan:v1",
  "title": "Bread/Meat Plan and Research Hypothesis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "kind",
    "colony_id",
    "goal",
    "prerequisite_refs",
    "evidence_refs",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "ce.bread_meat.plan/1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "DIGITAL_BREAD",
        "DIGITAL_MEAT",
        "MOLECULAR_RESEARCH_DOSSIER"
      ]
    },
    "colony_id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "layer_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prerequisite_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "instructional_object_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assessment_contract_ref": {
      "type": "string",
      "minLength": 1
    },
    "holdout_dataset_ref": {
      "type": "string",
      "minLength": 1
    },
    "competence_gap_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "protected_root_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "molecular_role_hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "literature_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "named_molecule_family": {
          "type": "string",
          "minLength": 1
        },
        "measured_assay_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "receiver_hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "enum": [
            "F",
            "X",
            "H",
            "D",
            "A"
          ]
        },
        "confounders": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "evidence_class",
        "literature_refs"
      ]
    },
    "status": {
      "enum": [
        "PROPOSED",
        "REVIEWED",
        "DIGITAL_READY",
        "REJECTED",
        "UNRESOLVED"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "builder_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "author_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "MOLECULAR_RESEARCH_DOSSIER"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "molecular_role_hypothesis"
        ]
      }
    }
  ]
}
