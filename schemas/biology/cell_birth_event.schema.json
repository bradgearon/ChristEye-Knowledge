{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preparation_id",
    "source_lot_id",
    "record_id",
    "created_at",
    "evidence_status",
    "evidence_ref",
    "parent_cell_track_id",
    "daughter_observation_ids",
    "clone_lineage_id",
    "observed_at",
    "division_evidence_ref",
    "observation_method",
    "lineage_confidence",
    "reviewer_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "preparation_id": {
      "type": "string",
      "minLength": 1
    },
    "source_lot_id": {
      "type": "string",
      "minLength": 1
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_status": {
      "enum": [
        "DESIGN",
        "PROPOSED",
        "OBSERVED",
        "ASSOCIATIONAL",
        "CAUSAL_RESEARCH",
        "UNRESOLVED",
        "REJECTED"
      ]
    },
    "evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_cell_track_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "daughter_observation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clone_lineage_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "division_evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "observation_method": {
      "type": "string",
      "minLength": 1
    },
    "lineage_confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "reviewer_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
