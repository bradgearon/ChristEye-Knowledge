{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preparation_id",
    "source_lot_id",
    "record_id",
    "created_at",
    "evidence_status",
    "evidence_ref",
    "care_plan_ref",
    "sop_ref",
    "qualified_operator_role",
    "independent_service_path_ref",
    "environment_status",
    "service_due_at",
    "last_verified_service_receipt",
    "medium_lot_ref",
    "sensor_freshness_ref",
    "human_review_required",
    "task_dependent_care"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "preparation_id": {
      "type": "string",
      "minLength": 1
    },
    "source_lot_id": {
      "type": "string",
      "minLength": 1
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_status": {
      "enum": [
        "DESIGN",
        "PROPOSED",
        "OBSERVED",
        "ASSOCIATIONAL",
        "CAUSAL_RESEARCH",
        "UNRESOLVED",
        "REJECTED"
      ]
    },
    "evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "care_plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "sop_ref": {
      "type": "string",
      "minLength": 1
    },
    "qualified_operator_role": {
      "type": "string",
      "minLength": 1
    },
    "independent_service_path_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment_status": {
      "enum": [
        "NORMAL",
        "DEVIATION",
        "UNKNOWN",
        "UNQUALIFIED"
      ]
    },
    "service_due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_verified_service_receipt": {
      "type": [
        "string",
        "null"
      ]
    },
    "medium_lot_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "sensor_freshness_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "human_review_required": {
      "type": "boolean"
    },
    "task_dependent_care": {
      "const": false
    }
  }
}
