{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Anaiero growth request",
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{3,90}$"
    },
    "target_module": {
      "type": "string",
      "minLength": 1
    },
    "missing_capability": {
      "type": "string",
      "minLength": 1
    },
    "alternatives_considered": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "protected_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]{3,90}$"
      }
    },
    "expected_gain": {
      "type": [
        "number",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operator_review_required": {
      "const": true
    }
  },
  "required": [
    "request_id",
    "target_module",
    "missing_capability",
    "alternatives_considered",
    "protected_roots",
    "evidence_refs",
    "operator_review_required"
  ]
}
