{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StarChipManifest",
  "type": "object",
  "required": [
    "schema_version",
    "module_id",
    "name",
    "version",
    "stage",
    "capabilities",
    "ports",
    "resources",
    "integration_refs",
    "boot_dependencies"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "module_id": {
      "type": "string",
      "pattern": "^CE-(P|D|R)\\d{2}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-.][A-Za-z0-9.-]+)?$"
    },
    "stage": {
      "enum": [
        "DIGITAL-V1",
        "LAB-RESEARCH",
        "HYPOTHESIS"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "ports": {
      "type": "object",
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "input": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "output": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": [
        "execution_class",
        "fallback"
      ],
      "properties": {
        "execution_class": {
          "enum": [
            "background",
            "interactive",
            "realtime",
            "research"
          ]
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        },
        "max_latency_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "evidence_state": {
      "enum": [
        "design",
        "experimental",
        "qualified"
      ]
    },
    "integration_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CE-(P|D|R)\\d{2}$"
      },
      "uniqueItems": true
    },
    "boot_dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CE-(P|D|R)\\d{2}$"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
