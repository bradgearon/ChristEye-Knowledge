{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CrystalPackManifest",
  "type": "object",
  "required": [
    "schema_version",
    "pack_id",
    "name",
    "version",
    "kind",
    "status",
    "installable",
    "target_modules",
    "capabilities",
    "assets",
    "activation",
    "rights",
    "evidence",
    "safety"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{4,100}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-.][A-Za-z0-9.-]+)?$"
    },
    "kind": {
      "enum": [
        "library",
        "skill",
        "model_adapter",
        "style_policy",
        "tool",
        "composite",
        "physical_candidate",
        "molecular_candidate"
      ]
    },
    "status": {
      "enum": [
        "digital-demo",
        "research-only",
        "qualified-digital"
      ]
    },
    "installable": {
      "type": "boolean"
    },
    "target_modules": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CE-(P|D|R)\\d{2}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "media_type"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^assets/[A-Za-z0-9_./-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "activation": {
      "type": "object",
      "required": [
        "mode",
        "warmup_steps",
        "checks"
      ],
      "properties": {
        "mode": {
          "enum": [
            "index",
            "calibrate",
            "study",
            "stage-tool",
            "research"
          ]
        },
        "warmup_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "rights": {
      "type": "object",
      "required": [
        "source",
        "redistribution_allowed"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "redistribution_allowed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "level",
        "claim",
        "status"
      ],
      "properties": {
        "level": {
          "enum": [
            "F",
            "X",
            "H",
            "D"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "proposal",
            "assessed",
            "validated"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": [
        "biological_installation",
        "ingestion_or_delivery",
        "human_review"
      ],
      "properties": {
        "biological_installation": {
          "type": "boolean"
        },
        "ingestion_or_delivery": {
          "type": "boolean"
        },
        "human_review": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "design_only": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
