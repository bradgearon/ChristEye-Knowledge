{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Anaiero Digital Crystal v2",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "digital-experience-replay"
    },
    "installable": {
      "const": true
    },
    "permission_mode": {
      "enum": [
        "local-only",
        "shareable"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_tier": {
      "enum": [
        "D",
        "H",
        "X",
        "F"
      ]
    },
    "physical_carrier": {
      "const": false
    },
    "asset": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "assets/experiences.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "source_event_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]{3,90}$"
      }
    },
    "readers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "activation": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "pack_id",
    "version",
    "kind",
    "installable",
    "permission_mode",
    "claims",
    "evidence_tier",
    "physical_carrier",
    "asset",
    "source_event_ids",
    "readers",
    "activation",
    "disclaimer"
  ]
}
