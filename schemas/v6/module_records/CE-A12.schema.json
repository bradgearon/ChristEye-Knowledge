{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LotusDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "state_snapshot",
    "candidates",
    "expected_effects",
    "protected_margin",
    "uncertainty",
    "ranking_policy",
    "veto_receipt",
    "result"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "description": "uuid"
    },
    "state_snapshot": {
      "type": "string",
      "description": "sha256"
    },
    "candidates": {
      "type": "array",
      "description": "list"
    },
    "expected_effects": {
      "type": "string",
      "description": "vector"
    },
    "protected_margin": {
      "type": "string",
      "description": "vector"
    },
    "uncertainty": {
      "type": "object",
      "description": "object"
    },
    "ranking_policy": {
      "type": "string",
      "description": "string"
    },
    "veto_receipt": {
      "type": "string",
      "description": "string"
    },
    "result": {
      "type": "string",
      "description": "enum"
    },
    "review_due": {
      "type": "string",
      "description": "UTC?"
    }
  }
}