cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED CE_REPO OR NOT DEFINED CE_TEMP)
  message(FATAL_ERROR "Set CE_REPO and a new isolated CE_TEMP for the actual package pair")
endif()
if(NOT DEFINED CE_CONFIG)
  set(CE_CONFIG Release)
endif()
if(EXISTS "${CE_TEMP}")
  message(FATAL_ERROR "Package-pair destination exists; preserve it and choose a new fixture directory")
endif()
file(MAKE_DIRECTORY "${CE_TEMP}")
function(ok label)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 600)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${label}: ${result}\n${output}\n${error}")
  endif()
  set(OUTPUT "${output}" PARENT_SCOPE)
endfunction()
function(bad label)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 90)
  if(result EQUAL 0)
    message(FATAL_ERROR "${label} was unexpectedly admitted: ${output}")
  endif()
endfunction()
set(generator)
if(DEFINED CE_GENERATOR AND NOT CE_GENERATOR STREQUAL "")
  set(generator -G "${CE_GENERATOR}")
endif()
set(suffix "")
if(WIN32)
  set(suffix ".exe")
endif()
set(snapshot "${CE_TEMP}/source-a")
file(MAKE_DIRECTORY "${snapshot}/qualification")
foreach(directory native deployment examples)
  file(COPY "${CE_REPO}/${directory}" DESTINATION "${snapshot}")
endforeach()
file(COPY "${CE_REPO}/qualification/native" DESTINATION "${snapshot}/qualification")
foreach(release a b)
  set(source "${CE_TEMP}/source-${release}")
  if(release STREQUAL b)
    file(COPY "${snapshot}/" DESTINATION "${source}")
    set(host_source "${source}/native/src/host/release_notice.txt")
    file(READ "${host_source}" text)
    string(REPLACE "Anaiero canonical native host" "Anaiero canonical native host compatible release B" updated "${text}")
    if(updated STREQUAL text)
      message(FATAL_ERROR "Host-only source update fixture no longer matches")
    endif()
    file(WRITE "${host_source}" "${updated}")
  endif()
  set(build "${CE_TEMP}/build-${release}")
  set(package "${CE_TEMP}/package-${release}")
  ok("configure release ${release}" "${CMAKE_COMMAND}" -S "${source}/native" -B "${build}" ${generator}
    -DANAIERO_CONTROLLER_ONLY=ON -DCE_WIND_BUILD_TESTS=OFF -DANAIERO_ENABLE_MESH=OFF "-DCMAKE_BUILD_TYPE=${CE_CONFIG}")
  ok("build release ${release}" "${CMAKE_COMMAND}" --build "${build}" --config "${CE_CONFIG}" --parallel 2)
  ok("package release ${release}" "${CMAKE_COMMAND}" "-DANAIERO_BUILD_DIR=${build}" "-DANAIERO_PACKAGE_DIR=${package}"
    "-DANAIERO_CONFIG=${CE_CONFIG}" -P "${source}/native/cmake/BuildNativePackage.cmake")
  set(host_${release} "${package}/bin/ce_modular_host${suffix}")
  set(session_${release} "${package}/bin/ce_modular_session${suffix}")
  ok("inspect actual release ${release}" "${host_${release}}" package-info)
  string(JSON build_${release} GET "${OUTPUT}" module_sha256)
  string(JSON compatibility_${release} GET "${OUTPUT}" compatibility_sha256)
  file(SHA256 "${host_${release}}" host_digest_${release})
endforeach()
if(build_a STREQUAL build_b OR host_digest_a STREQUAL host_digest_b OR NOT compatibility_a STREQUAL compatibility_b)
  message(FATAL_ERROR "Actual host update must change executable/build hashes and preserve the exact compatibility closure")
endif()
set(store "${CE_TEMP}/session")
ok("initialize all five engines" "${session_a}" init "${CE_REPO}/examples/runtime/modular-native.cevsession" "${store}" 536870912)
ok("select release A review" "${host_a}" package-review "${store}" "${CE_TEMP}/package-a" initial "${CE_TEMP}/initial.plan")
ok("select release A" "${host_a}" package-activate "${store}" "${CE_TEMP}/initial.plan")
ok("accept initial work through real host" "${host_a}" run-through "${store}" 1)
bad("unbound new build" "${host_b}" check "${store}")
ok("review exact compatible host update" "${host_b}" package-review "${store}" "${CE_TEMP}/package-b" upgrade "${CE_TEMP}/upgrade.plan")
string(JSON migration GET "${OUTPUT}" compatibility_binding_migration)
if(NOT migration)
  message(FATAL_ERROR "Actual different build did not use a reviewed compatibility-binding migration")
endif()
ok("activate compatible update" "${host_b}" package-activate "${store}" "${CE_TEMP}/upgrade.plan")
bad("old selection startup" "${host_a}" check-selected "${store}")
ok("admit selected new host" "${host_b}" check-selected "${store}")
ok("accept suffix on actual new host" "${host_b}" run-through "${store}" 3)
ok("independent new session CLI runs through canonical binding" "${session_b}" run "${store}" 4)
ok("new session CLI audits accepted suffix" "${session_b}" audit "${store}")
ok("independent new session CLI reads binding" "${session_b}" status "${store}")
string(JSON before GET "${OUTPUT}" completed_cycles)
if(NOT before EQUAL 4)
  message(FATAL_ERROR "New build did not complete the accepted suffix")
endif()
ok("review reverse binding" "${host_b}" package-rollback-review "${store}" rollback "${CE_TEMP}/rollback.plan")
ok("reverse against current suffix" "${host_b}" package-activate "${store}" "${CE_TEMP}/rollback.plan")
ok("admit previous actual executable" "${host_a}" check-selected "${store}")
ok("retry old upgrade without reselection" "${host_b}" package-activate "${store}" "${CE_TEMP}/upgrade.plan")
string(JSON duplicate GET "${OUTPUT}" duplicate)
string(JSON still_selected GET "${OUTPUT}" still_selected)
if(NOT duplicate OR still_selected)
  message(FATAL_ERROR "Old upgrade retry changed current selection")
endif()
ok("continue on previous executable" "${host_a}" run-through "${store}" 5)
ok("inspect suffix after rollback" "${session_a}" status "${store}")
string(JSON after GET "${OUTPUT}" completed_cycles)
if(NOT after EQUAL 5)
  message(FATAL_ERROR "Rollback rewound accepted work")
endif()
ok("audit accepted history" "${session_a}" audit "${store}")
file(WRITE "${CE_TEMP}/package-pair-report.json"
  "{\n  \"schema\":\"anaiero.package-pair/1\",\n  \"passed\":true,\n  \"migration\":\"compatibility-binding/1\",\n  \"old_build\":\"${build_a}\",\n  \"new_build\":\"${build_b}\",\n  \"old_executable_sha256\":\"${host_digest_a}\",\n  \"new_executable_sha256\":\"${host_digest_b}\",\n  \"compatibility_sha256\":\"${compatibility_a}\",\n  \"cycles_before_rollback\":4,\n  \"cycles_after_rollback\":5\n}\n")
message(STATUS "Actual distinct host builds, exact closure proof, accepted suffix, reverse binding and full audit passed")
