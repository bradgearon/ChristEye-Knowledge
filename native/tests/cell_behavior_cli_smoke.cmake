# End-to-end sealed development plan and idempotent resume.
if(NOT DEFINED CE_CELLS OR NOT DEFINED CE_ROOT OR NOT DEFINED CE_TMP)
  message(FATAL_ERROR "Missing test parameter")
endif()
file(REMOVE_RECURSE "${CE_TMP}")
file(MAKE_DIRECTORY "${CE_TMP}")
set(ATLAS "${CE_ROOT}/examples/cells/crest-blood-neural.cevatlas")
set(PLAN "${CE_ROOT}/examples/cells/reference-development.cevcellrun")
set(STATE "${CE_TMP}/culture.cevcells")
execute_process(COMMAND "${CE_CELLS}" sample "${ATLAS}" "${STATE}" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Failed to create synthetic culture")
endif()
execute_process(COMMAND "${CE_CELLS}" execute "${ATLAS}" "${STATE}" "${PLAN}"
 RESULT_VARIABLE code OUTPUT_VARIABLE output)
if(NOT code EQUAL 0 OR NOT output MATCHES "\"tick\":18" OR NOT output MATCHES "\"links\":1")
  message(FATAL_ERROR "Staged digital run failed: ${output}")
endif()
file(READ "${STATE}" first)
execute_process(COMMAND "${CE_CELLS}" execute "${ATLAS}" "${STATE}" "${PLAN}"
 RESULT_VARIABLE code)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Idempotent plan resume rejected")
endif()
file(READ "${STATE}" second)
if(NOT first STREQUAL second)
  message(FATAL_ERROR "Completed plan changed checkpoint on replay")
endif()
execute_process(COMMAND "${CE_CELLS}" run "${ATLAS}" "${STATE}" 2 RESULT_VARIABLE code)
if(code EQUAL 0)
  message(FATAL_ERROR "Unplanned execution was allowed on a pinned culture")
endif()
