cmake_minimum_required(VERSION 3.20)
string(RANDOM LENGTH 18 ALPHABET 0123456789abcdef nonce)
set(store "${BUILD_DIRECTORY}/packed-process-${nonce}")
if(EXISTS "${store}")
  message(FATAL_ERROR "Expected an unused directory for the interrupted store")
endif()
file(MAKE_DIRECTORY "${store}")
file(COPY "${FIXTURE_SOURCE}/" DESTINATION "${store}")
execute_process(COMMAND "${TEST_EXECUTABLE}" --cut "${store}" RESULT_VARIABLE cut)
if(NOT cut STREQUAL "77")
  message(FATAL_ERROR "Writer did not exit at the declared publication cut: ${cut}")
endif()
execute_process(COMMAND "${TEST_EXECUTABLE}" --recover "${store}" RESULT_VARIABLE recovered)
if(NOT recovered STREQUAL "0")
  message(FATAL_ERROR "Independent process could not recover the published store: ${recovered}")
endif()
file(REMOVE_RECURSE "${store}")
