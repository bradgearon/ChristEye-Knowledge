function(success label)
  execute_process(COMMAND "${CE_SESSION}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${code}" STREQUAL "0")
    message(FATAL_ERROR "${label}: exit=${code}\n${output}\n${error}")
  endif()
  set(OUTPUT "${output}" PARENT_SCOPE)
endfunction()
function(failure label expected)
  execute_process(COMMAND "${CE_SESSION}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if("${code}" STREQUAL "0" OR NOT error MATCHES "${expected}")
    message(FATAL_ERROR "${label}: expected ${expected}, got exit=${code}\n${output}\n${error}")
  endif()
endfunction()
function(field expected)
  string(JSON actual ERROR_VARIABLE error GET "${OUTPUT}" ${ARGN})
  if(NOT error STREQUAL "NOTFOUND" OR NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "JSON ${ARGN}: expected ${expected}, got ${actual}; ${error}\n${OUTPUT}")
  endif()
endfunction()
function(engine_field id key expected)
  string(JSON count LENGTH "${OUTPUT}" engines)
  math(EXPR last "${count}-1")
  foreach(i RANGE 0 ${last})
    string(JSON name GET "${OUTPUT}" engines ${i} id)
    if(name STREQUAL id)
      string(JSON actual GET "${OUTPUT}" engines ${i} ${key})
      if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "Engine ${id}.${key}: expected ${expected}, got ${actual}")
      endif()
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "Engine ${id} not found in ${OUTPUT}")
endfunction()
function(admin text)
