cmake_minimum_required(VERSION 3.20)
if(NOT "$ENV{GITHUB_ACTIONS}" STREQUAL "true" OR NOT "$ENV{ANAIERO_REQUIRE_SUPERVISOR}" STREQUAL "1")
  message(FATAL_ERROR "Real supervisor fixture runs only in explicitly enabled isolated GitHub Actions")
endif()
if(NOT DEFINED CE_REPO OR NOT DEFINED CE_PAIR OR NOT EXISTS "${CE_PAIR}/package-pair-report.json")
  message(FATAL_ERROR "First run the actual two-build package pair into CE_PAIR")
endif()
string(SHA256 id "${CE_PAIR}|$ENV{GITHUB_RUN_ID}|$ENV{GITHUB_RUN_ATTEMPT}")
string(SUBSTRING "${id}" 0 12 id)
set(name "AnaieroPackageFixture${id}")
set(store "${CE_PAIR}/supervisor-store")
if(EXISTS "${store}")
  message(FATAL_ERROR "Supervisor fixture store exists; use a fresh pair")
endif()
set(a "${CE_PAIR}/package-a")
set(b "${CE_PAIR}/package-b")
if(WIN32)
  set(suffix ".exe")
  set(helper powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "${CE_REPO}/deployment/native/manage-package-service.ps1")
  set(name_args -Name "${name}")
  set(install_args -Executable "${a}/bin/ce_modular_host.exe" -StateDirectory "${store}" -Endpoint "${name}" -PeriodMilliseconds 25 -IsolatedTest)
else()
  set(suffix "")
  execute_process(COMMAND id -un OUTPUT_VARIABLE user OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE identity)
  if(NOT identity EQUAL 0 OR user STREQUAL "root")
    message(FATAL_ERROR "Linux fixture requires isolated unprivileged runner with passwordless sudo")
  endif()
  set(helper sudo -n bash "${CE_REPO}/deployment/native/manage-modular-service.sh")
  set(name_args --name "${name}")
  set(install_args --controller "${a}/bin/ce_modular_host" --state "${store}" --user "${user}" --period 25)
endif()
set(host_a "${a}/bin/ce_modular_host${suffix}")
set(host_b "${b}/bin/ce_modular_host${suffix}")
set(session "${a}/bin/ce_modular_session${suffix}")
set(cleanup FALSE)
function(command label)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 180)
  if(NOT code EQUAL 0)
    if(cleanup)
      execute_process(COMMAND ${helper} Remove ${name_args} RESULT_VARIABLE ignored TIMEOUT 120)
    endif()
    message(FATAL_ERROR "${label}: ${code}\n${output}\n${error}")
  endif()
  set(OUTPUT "${output}" PARENT_SCOPE)
endfunction()
command("new store" "${session}" init "${CE_REPO}/examples/runtime/modular-native.cevsession" "${store}" 536870912)
command("review initial selection" "${host_a}" package-review "${store}" "${a}" first-supervisor "${CE_PAIR}/service-first.plan")
command("activate initial selection" "${host_a}" package-activate "${store}" "${CE_PAIR}/service-first.plan")
command("install real stopped registration" ${helper} Install ${name_args} ${install_args})
set(cleanup TRUE)
command("start first service" ${helper} Start ${name_args})
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 4)
command("drain first service" ${helper} Stop ${name_args})
command("first stopped checkpoint" "${host_a}" check-selected "${store}")
string(JSON first GET "${OUTPUT}" completed_cycles)
if(first LESS 1)
  command("clean failed zero-cycle service" ${helper} Remove ${name_args})
  message(FATAL_ERROR "SCM/systemd started without accepting any real session cycles")
endif()
command("review service update" "${host_a}" package-review "${store}" "${b}" update-supervisor "${CE_PAIR}/service-update.plan")
# Simulate interruption after the canonical commit but before supervisor config.
command("commit selection before registration update" "${host_a}" package-activate "${store}" "${CE_PAIR}/service-update.plan")
execute_process(COMMAND ${helper} Start ${name_args} RESULT_VARIABLE stale OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
if(stale EQUAL 0)
  command("clean incorrectly started stale service" ${helper} Remove ${name_args})
  message(FATAL_ERROR "Stale supervisor registration started after canonical selection changed")
endif()
command("reconcile stopped registration" ${helper} Reconcile ${name_args})
command("start compatible new service" ${helper} Start ${name_args})
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 4)
command("drain new service" ${helper} Stop ${name_args})
command("inspect accepted suffix" "${host_b}" check-selected "${store}")
string(JSON newer GET "${OUTPUT}" completed_cycles)
if(NOT newer GREATER first)
  command("clean failed suffix service" ${helper} Remove ${name_args})
  message(FATAL_ERROR "New service did not accept work")
endif()
command("review compatible rollback" "${host_b}" package-rollback-review "${store}" reverse-supervisor "${CE_PAIR}/service-rollback.plan")
if(WIN32)
  set(plan_arg -Plan)
else()
  set(plan_arg --plan)
endif()
command("switch registration back at current root" ${helper} Switch ${name_args} ${plan_arg} "${CE_PAIR}/service-rollback.plan")
command("rollback preserves accepted suffix" "${host_a}" check-selected "${store}")
string(JSON after GET "${OUTPUT}" completed_cycles)
if(NOT newer EQUAL after)
  command("clean failed rollback service" ${helper} Remove ${name_args})
  message(FATAL_ERROR "Service rollback changed accepted progress")
endif()
command("uninstall registration" ${helper} Remove ${name_args})
set(cleanup FALSE)
command("audit after uninstall" "${session}" audit "${store}")
if(NOT EXISTS "${host_a}" OR NOT EXISTS "${host_b}" OR NOT EXISTS "${store}/ROOT")
  message(FATAL_ERROR "Uninstall removed installed packages or canonical state")
endif()
file(WRITE "${CE_PAIR}/supervisor-report.json"
  "{\n\"schema\":\"anaiero.supervisor-fixture/1\",\"passed\":true,\"service\":\"${name}\",\"platform\":\"${CMAKE_HOST_SYSTEM_NAME}\",\"cycles_initial\":${first},\"cycles_after_update\":${newer},\"cycles_after_rollback\":${after},\"registration_removed\":true,\"audit_after_uninstall\":true\n}\n")
message(STATUS "Actual stopped install/start/drain, committed selection interruption, reconcile, post-write rollback, uninstall and retained audit passed")
