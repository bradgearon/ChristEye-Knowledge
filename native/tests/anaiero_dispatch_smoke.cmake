# Public Anaiero CLI smoke test using real backend executables.
if(NOT DEFINED CE_ANA OR NOT DEFINED CE_REPO OR NOT DEFINED CE_TEMP)
  message(FATAL_ERROR "Missing CLI test inputs")
endif()
function(success label)
  execute_process(COMMAND "${CE_ANA}" ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${rc}" STREQUAL "0")
    message(FATAL_ERROR "${label}: status=${rc}; stdout=${out}; stderr=${err}")
  endif()
  set(TEST_OUTPUT "${out}" PARENT_SCOPE)
endfunction()
success("help" help)
if(NOT TEST_OUTPUT MATCHES "anaiero <module>")
  message(FATAL_ERROR "Wrong help command")
endif()
success("version" version)
success("discovery" modules --json)
if(NOT TEST_OUTPUT MATCHES "anaiero.modules/1" OR NOT TEST_OUTPUT MATCHES "\"name\":\"colony\"")
  message(FATAL_ERROR "Bad module discovery")
endif()
success("doctor" doctor)
if(NOT TEST_OUTPUT MATCHES "vm: ready" OR NOT TEST_OUTPUT MATCHES "select: ready")
  message(FATAL_ERROR "Incomplete installation")
endif()
success("VLM1" vm inspect "${CE_REPO}/examples/vlm/crest-garden.avlm")
success("VLM2" process inspect "${CE_REPO}/examples/vlm/process-garden.avlm")
success("plan" plan inspect "${CE_REPO}/examples/vlm/bread-first.cevplan" "${CE_REPO}/examples/vlm/plan-garden.avlm" "${CE_REPO}")
success("SIM1" sim)
if(NOT TEST_OUTPUT MATCHES "SIM1_UNCALIBRATED_DIGITAL")
  message(FATAL_ERROR "SIM1 output missing")
endif()
file(REMOVE_RECURSE "${CE_TEMP}")
success("quoted path" store verify "${CE_TEMP}/store with spaces")
execute_process(COMMAND "${CE_ANA}" "../../evil" RESULT_VARIABLE unknown OUTPUT_QUIET ERROR_QUIET)
if("${unknown}" STREQUAL "0")
  message(FATAL_ERROR "Unallowlisted executable accepted")
endif()
execute_process(COMMAND "${CE_ANA}" vm not-a-real-command RESULT_VARIABLE bad OUTPUT_QUIET ERROR_QUIET)
if("${bad}" STREQUAL "0")
  message(FATAL_ERROR "Backend failure exit swallowed")
endif()
