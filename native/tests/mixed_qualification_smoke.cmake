if(NOT DEFINED ANAIERO_QUALIFY OR NOT DEFINED ANAIERO_PROFILE OR NOT DEFINED ANAIERO_SESSION OR NOT DEFINED ANAIERO_OUTPUT)
  message(FATAL_ERROR "Mixed qualification executable, profile, session and isolated output are required")
endif()
file(REMOVE_RECURSE "${ANAIERO_OUTPUT}")
execute_process(COMMAND "${ANAIERO_QUALIFY}" mixed "${ANAIERO_PROFILE}" "${ANAIERO_SESSION}" "${ANAIERO_OUTPUT}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 220)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Mixed qualification failed: ${result}\n${error}\n${output}")
endif()
file(READ "${ANAIERO_OUTPUT}/report.json" report)
string(JSON schema GET "${report}" schema)
string(JSON passed GET "${report}" passed)
string(JSON cycles GET "${report}" workload cycles)
string(JSON task_rejections GET "${report}" workload task_rejections)
string(JSON command_rejections GET "${report}" workload command_rejections)
string(JSON identity GET "${report}" profile_sha256)
string(JSON session_identity GET "${report}" session_text_sha256)
string(JSON definition_identity GET "${report}" session_definition_sha256)
string(JSON percentile_method GET "${report}" percentile_method)
file(SHA256 "${ANAIERO_PROFILE}" expected_identity)
file(SHA256 "${ANAIERO_SESSION}" expected_session_identity)
file(SHA256 "${ANAIERO_OUTPUT}/session.definition" expected_definition_identity)
if(NOT schema STREQUAL "anaiero.mixed-qualification/1" OR NOT passed OR NOT cycles EQUAL 32 OR
   NOT task_rejections EQUAL 1 OR NOT command_rejections EQUAL 1 OR NOT identity STREQUAL expected_identity OR
   NOT session_identity STREQUAL expected_session_identity OR NOT definition_identity STREQUAL expected_definition_identity OR
   NOT percentile_method STREQUAL "log2-ceiling-capped-by-observed-maximum/1")
  message(FATAL_ERROR "Mixed report did not establish its exact declared inputs and workload: ${report}")
endif()
foreach(histogram snapshot_latency control_latency probe_latency)
  string(JSON maximum_ns GET "${report}" "${histogram}" maximum_ns)
  foreach(percentile p50_upper_ns p95_upper_ns p99_upper_ns)
    string(JSON upper_ns GET "${report}" "${histogram}" "${percentile}")
    if(upper_ns GREATER maximum_ns)
      message(FATAL_ERROR "Reported ${histogram} ${percentile} exceeds its exact observed maximum")
    endif()
  endforeach()
endforeach()
foreach(check queue_pressure_verified exact_control_retry_verified quota_rejection_verified restart_identity_verified finite_plan_completed audit_passed)
  string(JSON checked GET "${report}" checks "${check}")
  if(NOT checked)
    message(FATAL_ERROR "Mixed qualification did not establish ${check}")
  endif()
endforeach()
string(JSON engine_count LENGTH "${report}" engines)
if(NOT engine_count EQUAL 5)
  message(FATAL_ERROR "Mixed profile did not execute five engine families")
endif()
foreach(i RANGE 0 4)
  string(JSON id GET "${report}" engines ${i} instance_id)
  string(JSON tick GET "${report}" engines ${i} tick)
  if((id STREQUAL "program" AND NOT tick EQUAL 12) OR (id STREQUAL "colonies" AND NOT tick EQUAL 16) OR
     (id STREQUAL "environment" AND NOT tick EQUAL 30) OR ((id STREQUAL "cells" OR id STREQUAL "voltage") AND NOT tick EQUAL 32))
    message(FATAL_ERROR "Mixed profile changed model clock semantics for ${id}: ${tick}")
  endif()
endforeach()
execute_process(COMMAND "${ANAIERO_QUALIFY}" mixed "${ANAIERO_PROFILE}" "${ANAIERO_SESSION}" "${ANAIERO_OUTPUT}"
  RESULT_VARIABLE repeated OUTPUT_QUIET ERROR_QUIET)
file(READ "${ANAIERO_OUTPUT}/report.json" preserved)
if(repeated EQUAL 0 OR NOT preserved STREQUAL report)
  message(FATAL_ERROR "Mixed rerun replaced an existing report")
endif()
get_filename_component(profile_directory "${ANAIERO_PROFILE}" DIRECTORY)
foreach(long_profile mixed-24h mixed-7d)
  # Existing-output rejection occurs only after complete profile/session
  # admission. Validate long profiles without starting a shortened soak.
  execute_process(COMMAND "${ANAIERO_QUALIFY}" mixed "${profile_directory}/${long_profile}.cevqualification" "${ANAIERO_SESSION}" "${ANAIERO_OUTPUT}"
    RESULT_VARIABLE long_admission OUTPUT_QUIET ERROR_VARIABLE long_error)
  if(long_admission EQUAL 0 OR NOT long_error MATCHES "mixed qualification output already exists")
    message(FATAL_ERROR "Long profile was not validly admitted before immutable-output rejection: ${long_error}")
  endif()
endforeach()
file(READ "${ANAIERO_PROFILE}" profile)
file(WRITE "${ANAIERO_OUTPUT}/invalid-profile" "${profile}\nmaximum_run_ms=1\n")
execute_process(COMMAND "${ANAIERO_QUALIFY}" mixed "${ANAIERO_OUTPUT}/invalid-profile" "${ANAIERO_SESSION}" "${ANAIERO_OUTPUT}/invalid-run"
  RESULT_VARIABLE invalid OUTPUT_QUIET ERROR_QUIET)
if(invalid EQUAL 0 OR EXISTS "${ANAIERO_OUTPUT}/invalid-run")
  message(FATAL_ERROR "Duplicate mixed profile budget was accepted or mutated output")
endif()
# A deliberately impossible memory gate must leave a failed, inspectable report.
string(REPLACE "maximum_resident_bytes=268435456" "maximum_resident_bytes=1048576" failed_profile "${profile}")
file(WRITE "${ANAIERO_OUTPUT}/failing-profile" "${failed_profile}")
execute_process(COMMAND "${ANAIERO_QUALIFY}" mixed "${ANAIERO_OUTPUT}/failing-profile" "${ANAIERO_SESSION}" "${ANAIERO_OUTPUT}/failed-run"
  RESULT_VARIABLE failed OUTPUT_QUIET ERROR_VARIABLE failed_error TIMEOUT 220)
if(failed EQUAL 0 OR NOT EXISTS "${ANAIERO_OUTPUT}/failed-run/report.json")
  message(FATAL_ERROR "Failed mixed budget did not preserve a failed report: ${failed_error}")
endif()
file(READ "${ANAIERO_OUTPUT}/failed-run/report.json" failed_report)
string(JSON failed_passed GET "${failed_report}" passed)
string(JSON violations LENGTH "${failed_report}" violations)
if(failed_passed OR violations LESS 1)
  message(FATAL_ERROR "Failed mixed budget was reported as passing")
endif()
message(STATUS "Mixed host, exact restart, bounded pressure, pinned inputs and negative report verified")
