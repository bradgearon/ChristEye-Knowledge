# Native CLI integration: actual Cell Behavior checkpoint conversion in a modular store.
if(NOT CE_SESSION OR NOT CE_REPO OR NOT CE_TEMP)
  message(FATAL_ERROR "CE-SW-43 CLI test requires executable, repository and temporary directory")
endif()
file(REMOVE_RECURSE "${CE_TEMP}")
file(MAKE_DIRECTORY "${CE_TEMP}/reviews")
set(store "${CE_TEMP}/session")
set(plan "${CE_TEMP}/reviews/cells-migration.plan")
set(config "${CE_REPO}/examples/runtime/modular-native.cevsession")
function(pass label)
  execute_process(COMMAND "${CE_SESSION}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "${label} failed (${result}): ${output} ${error}")
  endif()
  set(OUTPUT "${output}" PARENT_SCOPE)
endfunction()
function(reject label expected)
  execute_process(COMMAND "${CE_SESSION}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if("${result}" STREQUAL "0" OR NOT error MATCHES "${expected}")
    message(FATAL_ERROR "${label}: expected ${expected}; result=${result} output=${output} error=${error}")
  endif()
endfunction()
pass("initialize canonical session" init "${config}" "${store}" 67108864)
reject("migration requires paused engine" conflict migration-review "${store}" cells early-migrate CEVCELLSTATE/2 "${plan}")
pass("pause Cell Behavior" pause "${store}" cells pause-cells-ce43)
pass("review actual v1-to-v2" migration-review "${store}" cells migration-ce43 CEVCELLSTATE/2 "${plan}")
if(NOT EXISTS "${plan}")
  message(FATAL_ERROR "Migration review failed to publish a durable plan")
endif()
string(JSON target GET "${OUTPUT}" target_schema)
if(NOT target STREQUAL "CEVCELLSTATE/2")
  message(FATAL_ERROR "Wrong reviewed target schema ${target}")
endif()
configure_file("${plan}" "${CE_TEMP}/reviews/tampered.plan" COPYONLY)
file(APPEND "${CE_TEMP}/reviews/tampered.plan" "x")
reject("tampered plan" corrupt migration-activate "${store}" cells "${CE_TEMP}/reviews/tampered.plan")
pass("apply real migration" migration-activate "${store}" cells "${plan}")
pass("exact accepted retry" migration-activate "${store}" cells "${plan}")
pass("inspect retained migration" migration-status "${store}" migration-ce43)
string(JSON source GET "${OUTPUT}" source_schema)
if(NOT source STREQUAL "CEVCELLSTATE/1")
  message(FATAL_ERROR "Original schema provenance was lost")
endif()
pass("resume upgraded cell engine" resume "${store}" cells resume-cells-ce43)
pass("continue session with upgraded Cell Behavior engine" run "${store}" 3)
pass("audit upgraded canonical state" audit "${store}")
message(STATUS "CE-SW-43 CLI integration passed: review, conversion, retry, continuation and audit")
