# Native Windows/Linux CLI conformance; all paths are space-safe.
if(NOT DEFINED CE_SCI OR NOT DEFINED CE_ANA OR NOT DEFINED CE_ATLAS OR NOT DEFINED CE_TRACE OR NOT DEFINED CE_ENV_TRACE)
  message(FATAL_ERROR "Missing test inputs")
endif()
function(should_pass label)
  execute_process(COMMAND "${CE_SCI}" ${ARGN} RESULT_VARIABLE result
                  OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "${label}: exit ${result}\n${out}\n${err}")
  endif()
  set(CLI_OUTPUT "${out}" PARENT_SCOPE)
endfunction()
should_pass("engine-catalog" engines)
if(NOT CLI_OUTPUT MATCHES "\"name\":\"NEURON\"" OR NOT CLI_OUTPUT MATCHES "\"name\":\"PHYSICELL\"")
  message(FATAL_ERROR "Scientific engine registry contract failed")
endif()
should_pass("hypothesis-comparison" compare "${CE_ATLAS}")
if(NOT CLI_OUTPUT MATCHES "astrocyte_coupled" OR NOT CLI_OUTPUT MATCHES "shuffled_glial_signal")
  message(FATAL_ERROR "Scenario comparison incomplete")
endif()
should_pass("traced-electrical" replay "${CE_ATLAS}" "${CE_TRACE}")
if(NOT CLI_OUTPUT MATCHES "\"steps\":28" OR NOT CLI_OUTPUT MATCHES "source_epoch")
  message(FATAL_ERROR "Electrical trace replay invalid")
endif()
should_pass("traced-environment" environment "${CE_ATLAS}" "${CE_ENV_TRACE}")
if(NOT CLI_OUTPUT MATCHES "\"steps\":28")
  message(FATAL_ERROR "Environment trace replay invalid")
endif()
should_pass("windbus-projection" bus "${CE_ATLAS}")
if(NOT CLI_OUTPUT MATCHES "\"windpacket_updates\":84" OR
   NOT CLI_OUTPUT MATCHES "\"latest_revision\":84")
  message(FATAL_ERROR "WindBus and ColonyState projection mismatch")
endif()
execute_process(COMMAND "${CE_ANA}" help science RESULT_VARIABLE result OUTPUT_VARIABLE out)
if(NOT "${result}" STREQUAL "0" OR NOT out MATCHES "science")
  message(FATAL_ERROR "Public Anaiero command has no science module")
endif()
