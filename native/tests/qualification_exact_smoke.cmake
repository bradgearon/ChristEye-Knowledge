if(NOT DEFINED ANAIERO_QUALIFY OR NOT DEFINED ANAIERO_PROFILE OR NOT DEFINED ANAIERO_OUTPUT)
  message(FATAL_ERROR "Exact qualification fixture paths are required")
endif()
file(REMOVE_RECURSE "${ANAIERO_OUTPUT}")
file(MAKE_DIRECTORY "${ANAIERO_OUTPUT}")
file(READ "${ANAIERO_PROFILE}" original)
string(REPLACE "ANAIEROQUALIFICATION/1" "ANAIEROQUALIFICATION/2\nlatency_gate=exact-nearest-rank-threshold/1" profile "${original}")
file(WRITE "${ANAIERO_OUTPUT}/exact.profile" "${profile}")
set(device "ANAIERODEVICE/1\nname=native-test-fixture\ndevice_class=shared\nmachine=CTest process\nprocessor=Recorded native environment\nmemory_bytes=1073741824\nstorage_device=Temporary test directory\nstorage_firmware=unavailable\nstorage_controller=unavailable\nfilesystem=Native environment report\nmount_options=unavailable\ndurability=Software test; no device qualification\ndependencies=Exact native build manifest\nconcurrent_work=Uncontrolled test worker\n")
file(WRITE "${ANAIERO_OUTPUT}/device declaration.cevdevice" "${device}")
execute_process(COMMAND "${ANAIERO_QUALIFY}" run "${ANAIERO_OUTPUT}/exact.profile" "${ANAIERO_OUTPUT}/missing-device"
  RESULT_VARIABLE missing OUTPUT_QUIET ERROR_QUIET)
if(missing EQUAL 0 OR EXISTS "${ANAIERO_OUTPUT}/missing-device")
  message(FATAL_ERROR "Exact profile admitted without a pinned device declaration")
endif()
foreach(invalid_suffix "memory_bytes=1\n" "unexpected=value\n")
  file(WRITE "${ANAIERO_OUTPUT}/invalid.device" "${device}${invalid_suffix}")
  execute_process(COMMAND "${ANAIERO_QUALIFY}" run "${ANAIERO_OUTPUT}/exact.profile" "${ANAIERO_OUTPUT}/invalid-run" "${ANAIERO_OUTPUT}/invalid.device"
    RESULT_VARIABLE invalid OUTPUT_QUIET ERROR_QUIET)
  if(invalid EQUAL 0 OR EXISTS "${ANAIERO_OUTPUT}/invalid-run")
    message(FATAL_ERROR "Invalid or duplicate device field was admitted")
  endif()
endforeach()
execute_process(COMMAND "${ANAIERO_QUALIFY}" run "${ANAIERO_OUTPUT}/exact.profile" "${ANAIERO_OUTPUT}/accepted" "${ANAIERO_OUTPUT}/device declaration.cevdevice"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 150)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Exact-threshold profile failed: ${error}\n${output}")
endif()
file(READ "${ANAIERO_OUTPUT}/accepted/report.json" report)
file(SHA256 "${ANAIERO_OUTPUT}/device declaration.cevdevice" device_hash)
string(JSON gate GET "${report}" latency_gate_method)
string(JSON retained_hash GET "${report}" device_declaration_sha256)
string(JSON passed GET "${report}" commit_threshold passed)
string(JSON count GET "${report}" commit_threshold samples)
string(JSON commit_count GET "${report}" commit samples)
if(NOT gate STREQUAL "exact-nearest-rank-threshold/1" OR NOT retained_hash STREQUAL device_hash OR NOT passed OR NOT count EQUAL commit_count)
  message(FATAL_ERROR "Exact acceptance and device witness are missing: ${report}")
endif()
string(JSON observed GET "${report}" slow_commits observed)
string(JSON retained GET "${report}" slow_commits retained)
string(JSON omitted GET "${report}" slow_commits omitted)
string(JSON maximum GET "${report}" commit maximum_ns)
string(JSON slow_maximum GET "${report}" slow_commits samples 0 elapsed_ns)
math(EXPR accounted "${retained}+${omitted}")
if(NOT accounted EQUAL commit_count OR NOT observed EQUAL commit_count OR NOT maximum EQUAL slow_maximum)
  message(FATAL_ERROR "Slow-commit witness lost the maximum or miscounted omitted samples")
endif()
math(EXPR last "${retained}-1")
foreach(index RANGE 0 ${last})
  string(JSON witness GET "${report}" slow_commits samples ${index})
  string(JSON op GET "${witness}" operation_id)
  string(JSON generation GET "${witness}" expected_generation)
  math(EXPR next "${generation}+1")
  set(stages 0)
  foreach(stage lock_wait validation staging blobs transaction root index cleanup)
    string(JSON ns GET "${witness}" stages_ns ${stage})
    math(EXPR stages "${stages}+${ns}")
  endforeach()
  string(JSON measured GET "${witness}" stages_ns total)
  string(JSON elapsed GET "${witness}" elapsed_ns)
  string(JSON committed GET "${witness}" committed)
  if(NOT op STREQUAL "qualification-batch-${next}" OR NOT committed OR NOT stages EQUAL measured OR measured GREATER elapsed)
    message(FATAL_ERROR "Slow-commit identity or disjoint stage accounting disagrees with its measured commit")
  endif()
endforeach()
file(SHA256 "${ANAIERO_OUTPUT}/accepted/device.cevdevice" copied_hash)
if(NOT copied_hash STREQUAL device_hash)
  message(FATAL_ERROR "Device declaration bytes changed during admission")
endif()
# A memory ceiling below this process's existing resident set must fail while
# retaining the declared device and every observed latency sample.
string(REGEX REPLACE "maximum_resident_bytes=[0-9]+" "maximum_resident_bytes=1048576" failed_profile "${profile}")
file(WRITE "${ANAIERO_OUTPUT}/failed.profile" "${failed_profile}")
execute_process(COMMAND "${ANAIERO_QUALIFY}" run "${ANAIERO_OUTPUT}/failed.profile" "${ANAIERO_OUTPUT}/failed" "${ANAIERO_OUTPUT}/device declaration.cevdevice"
  RESULT_VARIABLE failed OUTPUT_QUIET ERROR_QUIET TIMEOUT 150)
file(READ "${ANAIERO_OUTPUT}/failed/report.json" failure)
string(JSON failure_passed GET "${failure}" passed)
string(JSON failure_hash GET "${failure}" device_declaration_sha256)
if(failed EQUAL 0 OR failure_passed OR NOT failure_hash STREQUAL device_hash)
  message(FATAL_ERROR "Failed exact profile lost its failure or device witness")
endif()
message(STATUS "Exact threshold profile, original gate separation and device witnesses verified")
