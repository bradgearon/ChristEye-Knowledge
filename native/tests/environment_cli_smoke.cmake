# Exercise the shipped CLIs with a real mixed model session and pinned artifacts.
foreach(required CE_CONFIG CE_PROVIDER CE_PASSIVE CE_RUNTIME CE_CALIBRATE CE_REPO CE_TEMP)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
function(success label)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
  if(NOT "${rc}" STREQUAL "0")
    message(FATAL_ERROR "${label}: status=${rc}; stdout=${out}; stderr=${err}")
  endif()
  set(TEST_OUTPUT "${out}" PARENT_SCOPE)
endfunction()
file(REMOVE_RECURSE "${CE_TEMP}")
file(MAKE_DIRECTORY "${CE_TEMP}")
file(COPY "${CE_REPO}/examples/scientific/well-mixed-environment.cevmodel" DESTINATION "${CE_TEMP}")
success("environment setup" "${CE_CONFIG}" environment "${CE_PROVIDER}"
  "${CE_TEMP}/well-mixed-environment.cevmodel" "${CE_TEMP}/environment.cevsolver")
success("passive setup" "${CE_CONFIG}" native "${CE_PASSIVE}"
  "${CE_REPO}/examples/scientific/passive-membrane.cevmodel" "${CE_TEMP}/passive.cevsolver")
file(TO_CMAKE_PATH "${CE_REPO}" repo)
file(WRITE "${CE_TEMP}/mixed.cevsession"
  "CEVSESSION/2\nname mixed-environment\nperiod_ms 100\nstorage segmented 16\n"
  "engine 101 sw5 61 1 1 \"${repo}/examples/cells/crest-blood-neural.cevatlas\" \"${repo}/examples/runtime/two-neurons.cevcells\" 75 0 64 1\n"
  "engine 201 sim3 71 1 2 \"${repo}/examples/connected-gardens.cev\" \"-\" 0 0 0 0\n"
  "engine 301 scientific 81 1 1 \"passive.cevsolver\" \"-\" 0 0 0 0\n"
  "engine 302 scientific 82 1 2 \"environment.cevsolver\" \"-\" 0 0 0 0\nend\n")
success("mixed session" "${CE_RUNTIME}" session "${CE_TEMP}/mixed.cevsession" "${CE_TEMP}/state" 6)
foreach(fragment "\"cycles\":6" "concentration_micromolar" "microvolt" "micromolar" "\"sequence_gaps\":0")
  string(FIND "${TEST_OUTPUT}" "${fragment}" found)
  if(found LESS 0)
    message(FATAL_ERROR "Missing ${fragment}: ${TEST_OUTPUT}")
  endif()
endforeach()
string(REGEX REPLACE "\"available_bytes\":[0-9]+" "\"available_bytes\":0" first "${TEST_OUTPUT}")
success("mixed restart" "${CE_RUNTIME}" session "${CE_TEMP}/mixed.cevsession" "${CE_TEMP}/state")
string(REGEX REPLACE "\"available_bytes\":[0-9]+" "\"available_bytes\":0" recovered "${TEST_OUTPUT}")
if(NOT first STREQUAL recovered)
  message(FATAL_ERROR "Restart changed committed state\n${first}\n${recovered}")
endif()
success("continued mixed session" "${CE_RUNTIME}" session "${CE_TEMP}/mixed.cevsession" "${CE_TEMP}/state" 4)
if(NOT TEST_OUTPUT MATCHES "\"cycles\":10")
  message(FATAL_ERROR "Mixed continuation failed: ${TEST_OUTPUT}")
endif()
success("calibration" "${CE_CALIBRATE}" "${CE_REPO}/examples/scientific/calibration/reference.cevcalibration"
  "${CE_TEMP}/qualification.json")
file(READ "${CE_TEMP}/qualification.json" report_before)
string(JSON report_schema ERROR_VARIABLE json_error GET "${report_before}" schema)
if(NOT json_error STREQUAL "NOTFOUND" OR NOT report_schema STREQUAL "anaiero.environment-calibration/1")
  message(FATAL_ERROR "Invalid qualification JSON/schema: ${json_error}\n${report_before}")
endif()
string(JSON outcome GET "${report_before}" outcome)
string(JSON selected GET "${report_before}" selected_candidate)
string(JSON biological_validation GET "${report_before}" biological_validation)
string(JSON optimization GET "${report_before}" scientific_optimization_enabled)
string(JSON training_passed GET "${report_before}" training_passed)
string(JSON holdout_passed GET "${report_before}" holdout_passed)
if(NOT outcome STREQUAL "PASS" OR NOT selected STREQUAL "tau-1000ms" OR
    biological_validation OR optimization OR NOT training_passed OR NOT holdout_passed)
  message(FATAL_ERROR "Unexpected reference qualification result: ${report_before}")
endif()
execute_process(COMMAND "${CE_CALIBRATE}" "${CE_REPO}/examples/scientific/calibration/reference.cevcalibration"
  "${CE_TEMP}/qualification.json" RESULT_VARIABLE overwrite OUTPUT_QUIET ERROR_QUIET TIMEOUT 30)
file(READ "${CE_TEMP}/qualification.json" report_after)
if("${overwrite}" STREQUAL "0" OR NOT report_before STREQUAL report_after)
  message(FATAL_ERROR "Existing qualification report was overwritten")
endif()
file(APPEND "${CE_TEMP}/well-mixed-environment.cevmodel" "tampered\n")
execute_process(COMMAND "${CE_RUNTIME}" session "${CE_TEMP}/mixed.cevsession" "${CE_TEMP}/state" 1
  RESULT_VARIABLE tampered OUTPUT_QUIET ERROR_QUIET TIMEOUT 30)
if("${tampered}" STREQUAL "0")
  message(FATAL_ERROR "Changed environmental model bypassed configured digest")
endif()
