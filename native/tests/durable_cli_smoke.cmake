# Native command-line smoke test; suitable for Windows and Linux CTest.
if(NOT DEFINED CE_CLI OR NOT DEFINED CE_TMP)
  message(FATAL_ERROR "CE_CLI and CE_TMP required")
endif()
file(REMOVE_RECURSE "${CE_TMP}")
file(MAKE_DIRECTORY "${CE_TMP}")
file(WRITE "${CE_TMP}/rna.txt" "CERNA/1\norigin SIMULATED\n")
set(store "${CE_TMP}/store")
function(run_cli result_name)
  execute_process(COMMAND "${CE_CLI}" ${ARGN}
    RESULT_VARIABLE exit_code OUTPUT_VARIABLE captured ERROR_VARIABLE error)
  if(NOT exit_code EQUAL 0)
    message(FATAL_ERROR "ce_wind_durable ${ARGN} failed exit=${exit_code}: ${error}")
  endif()
  string(STRIP "${captured}" captured)
  set(${result_name} "${captured}" PARENT_SCOPE)
endfunction()
run_cli(check verify "${store}")
run_cli(hash import "${store}" "${CE_TMP}/rna.txt")
string(LENGTH "${hash}" hash_len)
if(NOT hash_len EQUAL 64 OR NOT hash MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "Unexpected import hash: '${hash}'")
endif()
run_cli(published publish "${store}" RNA_OBSERVATION b-17 "${hash}" SIMULATED 12 sim-clock)
string(REGEX REPLACE "^committed_event_sha256 " "" event_hash "${published}")
string(LENGTH "${event_hash}" event_hash_len)
if(NOT event_hash_len EQUAL 64 OR NOT event_hash MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "Unexpected event hash: '${event_hash}'")
endif()
run_cli(missed catchup "${store}" reader-a b-17 RNA_OBSERVATION)
if(NOT missed MATCHES "^event 1 ")
  message(FATAL_ERROR "Missing replay: '${missed}'")
endif()
run_cli(acked ack "${store}" reader-a 1 "${event_hash}")
run_cli(cursor cursor "${store}" reader-a)
if(NOT cursor MATCHES "^sequence 1 event_sha256 ")
  message(FATAL_ERROR "Cursor did not persist: '${cursor}'")
endif()
run_cli(empty catchup "${store}" reader-a b-17 RNA_OBSERVATION)
if(NOT "${empty}" STREQUAL "")
  message(FATAL_ERROR "Acknowledged event replayed: '${empty}'")
endif()
run_cli(verified verify "${store}")
if(NOT verified MATCHES "committed events=1")
  message(FATAL_ERROR "Store did not persist one event: '${verified}'")
endif()
file(REMOVE_RECURSE "${CE_TMP}")
