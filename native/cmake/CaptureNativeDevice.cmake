cmake_minimum_required(VERSION 3.20)
# This produces an explicit operator declaration, not hardware attestation.
# Shared CI defaults retain unknown device properties as unknown. A dedicated
# declaration requires the operator to supply every deployment-specific field.
if(NOT DEFINED ANAIERO_DEVICE_OUTPUT OR NOT DEFINED ANAIERO_DEVICE_NAME)
  message(FATAL_ERROR "Set ANAIERO_DEVICE_OUTPUT and ANAIERO_DEVICE_NAME")
endif()
if(NOT DEFINED ANAIERO_DEVICE_CLASS)
  set(ANAIERO_DEVICE_CLASS shared)
endif()
if(NOT ANAIERO_DEVICE_CLASS STREQUAL "shared" AND NOT ANAIERO_DEVICE_CLASS STREQUAL "dedicated")
  message(FATAL_ERROR "Device class must be shared or dedicated")
endif()
cmake_host_system_information(RESULT os QUERY OS_NAME)
cmake_host_system_information(RESULT release QUERY OS_RELEASE)
cmake_host_system_information(RESULT architecture QUERY OS_PLATFORM)
cmake_host_system_information(RESULT processor QUERY PROCESSOR_NAME)
cmake_host_system_information(RESULT memory_mib QUERY TOTAL_PHYSICAL_MEMORY)
math(EXPR memory_bytes "${memory_mib} * 1048576")
set(machine "${os} ${release} ${architecture}; host-visible memory rounded to MiB")
foreach(field STORAGE_DEVICE STORAGE_FIRMWARE STORAGE_CONTROLLER FILESYSTEM MOUNT_OPTIONS DURABILITY DEPENDENCIES CONCURRENT_WORK)
  if(NOT DEFINED ANAIERO_${field})
    if(ANAIERO_DEVICE_CLASS STREQUAL "dedicated")
      message(FATAL_ERROR "Dedicated device declaration requires ANAIERO_${field}")
    endif()
    set(ANAIERO_${field} "unavailable on shared runner; not independently verified")
  endif()
endforeach()
if(NOT ANAIERO_DEVICE_NAME MATCHES "^[A-Za-z0-9_.-]+$")
  message(FATAL_ERROR "Device declaration name must be a bounded token")
endif()
set(content "ANAIERODEVICE/1\nname=${ANAIERO_DEVICE_NAME}\ndevice_class=${ANAIERO_DEVICE_CLASS}\nmachine=${machine}\nprocessor=${processor}\nmemory_bytes=${memory_bytes}\n")
foreach(field STORAGE_DEVICE STORAGE_FIRMWARE STORAGE_CONTROLLER FILESYSTEM MOUNT_OPTIONS DURABILITY DEPENDENCIES CONCURRENT_WORK)
  set(value "${ANAIERO_${field}}")
  string(LENGTH "${value}" length)
  if(length EQUAL 0 OR length GREATER 512 OR value MATCHES "[\r\n]")
    message(FATAL_ERROR "ANAIERO_${field} must be one nonempty line up to512bytes")
  endif()
  string(TOLOWER "${field}" key)
  string(APPEND content "${key}=${value}\n")
endforeach()
get_filename_component(output "${ANAIERO_DEVICE_OUTPUT}" ABSOLUTE)
get_filename_component(parent "${output}" DIRECTORY)
if(NOT IS_DIRECTORY "${parent}")
  message(FATAL_ERROR "Create the output parent directory first")
endif()
file(LOCK "${output}.lock" GUARD PROCESS TIMEOUT 0 RESULT_VARIABLE lock_result)
if(NOT lock_result STREQUAL "0")
  message(FATAL_ERROR "Another process owns the device declaration")
endif()
if(EXISTS "${output}" OR IS_SYMLINK "${output}")
  message(FATAL_ERROR "Refusing to replace an existing device declaration")
endif()
file(WRITE "${output}" "${content}")
file(SHA256 "${output}" digest)
message(STATUS "Retained device declaration: ${output}; SHA256=${digest}")
