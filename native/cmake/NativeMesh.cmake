# Mesh policy and replay remain portable. Only the optional remote adapter links TLS.
if(CE_WIND_BUILD_TESTS)
  foreach(part mesh_authorization mesh_replay mesh_ingress mesh_export)
    anaiero_native_target(ce_${part}_tests tests/${part}_tests.cpp)
    target_compile_definitions(ce_${part}_tests PRIVATE CE_DURABLE_FAULT_TESTS=1)
    add_test(NAME anaiero_${part} COMMAND ce_${part}_tests
      ${CMAKE_CURRENT_BINARY_DIR}/${part}-tests)
    set_tests_properties(anaiero_${part} PROPERTIES TIMEOUT 180)
  endforeach()
endif()

if(NOT ANAIERO_ENABLE_MESH)
  return()
endif()
find_package(OpenSSL 3.0 REQUIRED COMPONENTS SSL Crypto)
add_library(anaiero_mesh_transport INTERFACE)
target_link_libraries(anaiero_mesh_transport INTERFACE anaiero_application
  OpenSSL::SSL OpenSSL::Crypto Threads::Threads)
if(WIN32)
  target_compile_definitions(anaiero_mesh_transport INTERFACE WIN32_LEAN_AND_MEAN NOMINMAX)
  target_link_libraries(anaiero_mesh_transport INTERFACE ws2_32 crypt32 advapi32)
endif()
anaiero_native_target(ce_mesh examples/mesh_cli.cpp)
target_link_libraries(ce_mesh PRIVATE anaiero_mesh_transport)
install(TARGETS ce_mesh RUNTIME DESTINATION bin)
if(TARGET anaiero)
  target_compile_definitions(anaiero PRIVATE ANAIERO_HAS_MESH=1)
  add_dependencies(anaiero ce_mesh)
endif()
if(CE_WIND_BUILD_TESTS)
  foreach(part mesh_tls mesh_integration)
    anaiero_native_target(ce_${part}_tests tests/${part}_tests.cpp)
    target_link_libraries(ce_${part}_tests PRIVATE anaiero_mesh_transport)
    if(part STREQUAL "mesh_tls")
      add_test(NAME anaiero_${part} COMMAND ce_${part}_tests ${CMAKE_CURRENT_BINARY_DIR}/${part}-tests)
    else()
      add_test(NAME anaiero_${part} COMMAND ce_${part}_tests
        ${CMAKE_CURRENT_BINARY_DIR}/${part}-tests $<TARGET_FILE:ce_mesh>
        ${CMAKE_CURRENT_SOURCE_DIR}/..)
    endif()
    set_tests_properties(anaiero_${part} PROPERTIES TIMEOUT 180 SKIP_RETURN_CODE 77)
  endforeach()
endif()
