# The whole-build identity stays unchanged. This separate witness identifies
# the complete project include closure used by the built-in engines and their
# state/identity codec; toolchain/configuration metadata remains part of it.
set(anaiero_contract_system_headers algorithm array atomic bit cerrno charconv chrono climits cmath
  condition_variable csignal cstddef cstdint cstdio cstdlib cstring ctime deque exception filesystem
  fstream functional future initializer_list iomanip iostream istream iterator limits locale map memory
  mutex optional ostream random set span sstream stdexcept string string_view system_error thread tuple
  unordered_set utility vector stddef.h stdint.h arpa/inet.h dlfcn.h fcntl.h poll.h psapi.h sddl.h spawn.h
  sys/file.h sys/mman.h sys/resource.h sys/socket.h sys/stat.h sys/statfs.h sys/statvfs.h sys/syscall.h
  sys/types.h sys/un.h sys/utsname.h sys/wait.h unistd.h windows.h winsock2.h ws2tcpip.h
  openssl/err.h openssl/ssl.h openssl/x509.h openssl/pem.h)
function(anaiero_contract_visit source)
  get_property(seen GLOBAL PROPERTY ANAIERO_CONTRACT_INPUTS)
  if(source IN_LIST seen)
    return()
  endif()
  set_property(GLOBAL APPEND PROPERTY ANAIERO_CONTRACT_INPUTS "${source}")
  file(STRINGS "${source}" includes REGEX "^[ \t]*#[ \t]*include")
  get_filename_component(parent "${source}" DIRECTORY)
  foreach(line IN LISTS includes)
    string(REGEX MATCH "include[ \t]*[<\"]([^>\"]+)[>\"]" matched "${line}")
    if(NOT matched)
      message(FATAL_ERROR "Nonliteral engine include needs an explicit qualified dependency: ${source}: ${line}")
    endif()
    set(name "${CMAKE_MATCH_1}")
    set(resolved false)
    foreach(base "${parent}" "${CMAKE_CURRENT_SOURCE_DIR}/sdk/include" "${CMAKE_CURRENT_SOURCE_DIR}/include" "${CMAKE_CURRENT_SOURCE_DIR}/src/host")
      if(EXISTS "${base}/${name}")
        get_filename_component(dependency "${base}/${name}" REALPATH)
        string(FIND "${dependency}" "${CMAKE_CURRENT_SOURCE_DIR}/" inside)
        if(NOT inside EQUAL 0)
          message(FATAL_ERROR "Engine project dependency escapes native source tree: ${dependency}")
        endif()
        anaiero_contract_visit("${dependency}")
        set(resolved true)
        break()
      endif()
    endforeach()
    if(NOT resolved)
      # Standard C++ headers belong to the declared compiler/toolchain. Every
      # quoted include or nonstandard/project header must resolve explicitly.
      if(line MATCHES "include[ \t]*\"" OR NOT name IN_LIST anaiero_contract_system_headers)
        message(FATAL_ERROR "Unresolved engine dependency: ${source}: ${name}")
      endif()
    endif()
  endforeach()
endfunction()
set_property(GLOBAL PROPERTY ANAIERO_CONTRACT_INPUTS "")
file(GLOB_RECURSE contract_roots CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/src/*.cpp" "${CMAKE_CURRENT_SOURCE_DIR}/src/*.hpp")
# Qualification/report code does not open a managed production session; the
# generated manifests cannot recursively be their own dependencies. The fixed
# adapters consuming generated data are separately hashed. Runtime/storage/session/mesh/
# lifecycle/deployment sources are pinned, not just the engine state codec.
list(FILTER contract_roots EXCLUDE REGEX "/src/qualification/")
list(REMOVE_ITEM contract_roots "${CMAKE_CURRENT_SOURCE_DIR}/src/host/build_witness.cpp")
list(REMOVE_ITEM contract_roots "${CMAKE_CURRENT_SOURCE_DIR}/src/host/release_notice.cpp")
list(APPEND contract_roots "${CMAKE_CURRENT_SOURCE_DIR}/examples/modular_session_cli.cpp"
  "${CMAKE_CURRENT_SOURCE_DIR}/examples/modular_mesh_cli.cpp" "${CMAKE_CURRENT_SOURCE_DIR}/examples/modular_host_cli.cpp")
foreach(source IN LISTS contract_roots)
  anaiero_contract_visit("${source}")
endforeach()
get_property(anaiero_contract_inputs GLOBAL PROPERTY ANAIERO_CONTRACT_INPUTS)
list(APPEND anaiero_contract_inputs "${CMAKE_CURRENT_SOURCE_DIR}/src/host/build_witness.cpp" "${CMAKE_CURRENT_SOURCE_DIR}/src/host/release_notice.cpp")
# Build recipes can change effective target flags/definitions independently of
# the C++ include graph. Until those are separately versioned, retain all of
# them conservatively rather than allowing a semantic change through CMake.
file(GLOB_RECURSE contract_recipes CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/cmake/*.cmake")
list(APPEND anaiero_contract_inputs ${contract_recipes} "${CMAKE_CURRENT_SOURCE_DIR}/CMakeLists.txt")
list(REMOVE_DUPLICATES anaiero_contract_inputs)
list(SORT anaiero_contract_inputs)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${anaiero_contract_inputs})
set(anaiero_contract_sources "")
foreach(source IN LISTS anaiero_contract_inputs)
  file(SHA256 "${source}" digest)
  file(RELATIVE_PATH relative "${CMAKE_CURRENT_SOURCE_DIR}" "${source}")
  string(APPEND anaiero_contract_sources "${relative} ${digest}\n")
endforeach()
# Record effective build capabilities in both witnesses. The historically
# recorded compiler/flags alone do not distinguish mesh-on from mesh-off.
file(SHA256 "${CMAKE_CXX_COMPILER}" anaiero_compiler_executable_sha256)
set(anaiero_external "compiler=${anaiero_compiler_executable_sha256},target=${CMAKE_CXX_COMPILER_TARGET},sysroot=${CMAKE_SYSROOT},sdk=${CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION},toolset=${CMAKE_VS_PLATFORM_TOOLSET},mesh=${ANAIERO_ENABLE_MESH},controller=${ANAIERO_CONTROLLER_ONLY}")
if(CMAKE_TOOLCHAIN_FILE)
  file(SHA256 "${CMAKE_TOOLCHAIN_FILE}" toolchain_digest)
  string(APPEND anaiero_external ",toolchain=${toolchain_digest}")
endif()
if(ANAIERO_ENABLE_MESH)
  find_package(OpenSSL 3.0 REQUIRED COMPONENTS SSL Crypto)
  string(APPEND anaiero_external ",openssl=${OPENSSL_VERSION}")
  foreach(target OpenSSL::SSL OpenSSL::Crypto)
    foreach(property IMPORTED_LOCATION IMPORTED_LOCATION_RELEASE IMPORTED_LOCATION_DEBUG IMPORTED_IMPLIB IMPORTED_IMPLIB_RELEASE IMPORTED_IMPLIB_DEBUG)
      get_target_property(library ${target} ${property})
      if(library AND EXISTS "${library}" AND NOT IS_DIRECTORY "${library}")
        file(SHA256 "${library}" library_digest)
        string(APPEND anaiero_external ",${target}:${property}=${library_digest}")
      endif()
    endforeach()
  endforeach()
endif()
function(anaiero_witness_literals value output)
  string(LENGTH "${value}" total)
  set(at 0)
  set(parts "")
  while(at LESS total)
    # MSVC has an individual string literal limit; never rely on concatenated
    # adjacent literals either. Build the exact LF witness from bounded pieces.
    string(SUBSTRING "${value}" ${at} 4096 part)
    string(FIND "${part}" ")CEWITNESS\"" delimiter)
    if(NOT delimiter EQUAL -1)
      message(FATAL_ERROR "Unsupported build witness raw-literal delimiter")
    endif()
    string(APPEND parts "R\"CEWITNESS(${part})CEWITNESS\",")
    math(EXPR at "${at}+4096")
  endwhile()
  set(${output} "${parts}" PARENT_SCOPE)
endfunction()
function(anaiero_write_compatibility profile full_manifest build_id)
  set(witness "Anaiero engine compatibility/1\n${CMAKE_CXX_COMPILER_ID}\n${CMAKE_CXX_COMPILER_VERSION}\n${CMAKE_SYSTEM_NAME}\n${CMAKE_SYSTEM_PROCESSOR}\n${CMAKE_BUILD_TYPE}\n${CMAKE_CXX_FLAGS}\n${CMAKE_CXX_FLAGS_RELEASE}\n${CMAKE_CXX_FLAGS_DEBUG}\n${CMAKE_CXX_FLAGS_RELWITHDEBINFO}\n${CMAKE_CXX_FLAGS_MINSIZEREL}\n${anaiero_contract_sources}")
  if(CMAKE_CONFIGURATION_TYPES)
    string(APPEND witness "Configuration: ${profile}\n")
  endif()
  string(APPEND witness "CMake: ${CMAKE_VERSION}\nMSVC runtime: ${CMAKE_MSVC_RUNTIME_LIBRARY}\nBuild capabilities: ${anaiero_external}\nContracts: session/2;engine-state/1;canonical-root/1;compatibility-binding/1\n")
  string(SHA256 compatibility_id "${witness}")
  set(folder "${CMAKE_CURRENT_BINARY_DIR}/generated/${profile}")
  file(MAKE_DIRECTORY "${folder}")
  file(READ "${CMAKE_CURRENT_SOURCE_DIR}/src/host/release_notice.txt" notice)
  string(STRIP "${notice}" notice)
  string(LENGTH "${notice}" notice_length)
  if(notice_length GREATER 120 OR NOT notice MATCHES "^[A-Za-z0-9 ._+/-]+$")
    message(FATAL_ERROR "Host release notice must be a 1..120 character presentation-only literal")
  endif()
  file(WRITE "${folder}/anaiero_release_notice.hpp" "#pragma once\n#include <string_view>\nnamespace anaiero::deployment::compiled {inline constexpr std::string_view release_notice=\"${notice}\";}\n")
  anaiero_witness_literals("${full_manifest}" full_parts)
  anaiero_witness_literals("${witness}" compatibility_parts)
  file(WRITE "${folder}/anaiero_build_witness.hpp" "#pragma once\n#include <string_view>\nnamespace anaiero::deployment::compiled {\ninline constexpr std::string_view build_id=\"${build_id}\";\ninline constexpr std::string_view compatibility_id=\"${compatibility_id}\";\ninline constexpr std::string_view build_manifest[]={${full_parts}};\ninline constexpr std::string_view compatibility_manifest[]={${compatibility_parts}};\n}\n")
  set(file "${CMAKE_CURRENT_BINARY_DIR}/anaiero-compatibility-manifest-${profile}.txt")
  file(WRITE "${file}" "${witness}")
  if(CMAKE_CONFIGURATION_TYPES)
    install(FILES "${file}" DESTINATION share/anaiero RENAME anaiero-compatibility-manifest.txt CONFIGURATIONS "${profile}")
  else()
    install(FILES "${file}" DESTINATION share/anaiero RENAME anaiero-compatibility-manifest.txt)
  endif()
endfunction()
