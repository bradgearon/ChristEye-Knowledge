cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED ANAIERO_BUILD_DIR OR NOT DEFINED ANAIERO_PACKAGE_DIR)
  message(FATAL_ERROR "Set ANAIERO_BUILD_DIR and ANAIERO_PACKAGE_DIR (new empty destination)")
endif()
if(NOT DEFINED ANAIERO_CONFIG)
  set(ANAIERO_CONFIG Release)
endif()
if(NOT DEFINED ANAIERO_PROFILE)
  set(ANAIERO_PROFILE native-canonical-functional)
endif()
if(NOT ANAIERO_PROFILE MATCHES "^[A-Za-z0-9._-]+$")
  message(FATAL_ERROR "Package profile must be a bounded token")
endif()
if(EXISTS "${ANAIERO_PACKAGE_DIR}")
  message(FATAL_ERROR "Package destination already exists; choose a fresh directory")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${ANAIERO_BUILD_DIR}"
  --prefix "${ANAIERO_PACKAGE_DIR}" --config "${ANAIERO_CONFIG}" RESULT_VARIABLE installed)
if(NOT installed EQUAL 0)
  message(FATAL_ERROR "Native install failed; incomplete package remains for inspection")
endif()
set(host "${ANAIERO_PACKAGE_DIR}/bin/ce_modular_host${CMAKE_EXECUTABLE_SUFFIX}")
if(WIN32)
  set(host "${ANAIERO_PACKAGE_DIR}/bin/ce_modular_host.exe")
endif()
execute_process(COMMAND "${host}" package-info RESULT_VARIABLE info_result OUTPUT_VARIABLE host_info)
if(NOT info_result EQUAL 0)
  message(FATAL_ERROR "Installed host cannot report its exact compiled package identity")
endif()
string(JSON module GET "${host_info}" module_sha256)
string(JSON manifest SET "{}" schema "\"anaiero.native-package/1\"")
string(JSON manifest SET "${manifest}" profile "\"${ANAIERO_PROFILE}\"")
string(JSON manifest SET "${manifest}" configuration "\"${ANAIERO_CONFIG}\"")
string(JSON manifest SET "${manifest}" host_system "\"${CMAKE_HOST_SYSTEM_NAME}\"")
string(JSON manifest SET "${manifest}" module_sha256 "\"${module}\"")
string(JSON manifest SET "${manifest}" files "[]")
file(GLOB_RECURSE files RELATIVE "${ANAIERO_PACKAGE_DIR}" LIST_DIRECTORIES false "${ANAIERO_PACKAGE_DIR}/*")
list(SORT files)
set(count 0)
foreach(path IN LISTS files)
  if(IS_SYMLINK "${ANAIERO_PACKAGE_DIR}/${path}")
    message(FATAL_ERROR "Package inventory refuses symlinks: ${path}")
  endif()
  file(SHA256 "${ANAIERO_PACKAGE_DIR}/${path}" digest)
  file(SIZE "${ANAIERO_PACKAGE_DIR}/${path}" size)
  string(REPLACE "\\" "\\\\" escaped "${path}")
  string(REPLACE "\"" "\\\"" escaped "${escaped}")
  string(JSON entry SET "{}" path "\"${escaped}\"")
  string(JSON entry SET "${entry}" sha256 "\"${digest}\"")
  string(JSON entry SET "${entry}" bytes "${size}")
  string(JSON manifest SET "${manifest}" files ${count} "${entry}")
  math(EXPR count "${count}+1")
endforeach()
file(WRITE "${ANAIERO_PACKAGE_DIR}/package-manifest.json" "${manifest}\n")
include("${CMAKE_CURRENT_LIST_DIR}/VerifyNativePackage.cmake")
if(DEFINED ANAIERO_ARCHIVE)
  get_filename_component(parent "${ANAIERO_PACKAGE_DIR}" DIRECTORY)
  get_filename_component(name "${ANAIERO_PACKAGE_DIR}" NAME)
  if(EXISTS "${ANAIERO_ARCHIVE}")
    message(FATAL_ERROR "Archive destination exists; refusing to replace it")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${ANAIERO_ARCHIVE}" --format=gnutar "${name}"
    WORKING_DIRECTORY "${parent}" RESULT_VARIABLE archived)
  if(NOT archived EQUAL 0)
    message(FATAL_ERROR "Native package archive creation failed")
  endif()
endif()
message(STATUS "Native package recorded ${count} exact files for module ${module}")
