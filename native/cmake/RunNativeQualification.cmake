cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED ANAIERO_BUILD_DIR OR NOT DEFINED ANAIERO_PROFILE OR NOT DEFINED ANAIERO_OUTPUT)
  message(FATAL_ERROR "Set ANAIERO_BUILD_DIR, ANAIERO_PROFILE and new ANAIERO_OUTPUT")
endif()
if(NOT DEFINED ANAIERO_CONFIG)
  set(ANAIERO_CONFIG Release)
endif()
set(program ce_native_qualification)
if(WIN32)
  string(APPEND program .exe)
endif()
set(executable "${ANAIERO_BUILD_DIR}/${program}")
if(EXISTS "${ANAIERO_BUILD_DIR}/${ANAIERO_CONFIG}/${program}")
  set(executable "${ANAIERO_BUILD_DIR}/${ANAIERO_CONFIG}/${program}")
endif()
if(NOT EXISTS "${executable}")
  message(FATAL_ERROR "Build the native qualification executable first: ${executable}")
endif()
execute_process(COMMAND "${executable}" run "${ANAIERO_PROFILE}" "${ANAIERO_OUTPUT}"
  RESULT_VARIABLE result TIMEOUT 5400)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Native qualification failed or exceeded its declared limits: ${result}; inspect ${ANAIERO_OUTPUT}/report.json")
endif()
