cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED ANAIERO_BUILD_DIR OR NOT DEFINED ANAIERO_PROFILE OR NOT DEFINED ANAIERO_OUTPUT)
  message(FATAL_ERROR "Set ANAIERO_BUILD_DIR, ANAIERO_PROFILE and new ANAIERO_OUTPUT")
endif()
if(NOT DEFINED ANAIERO_CONFIG)
  set(ANAIERO_CONFIG Release)
endif()
# Resolve paths once in the invoking directory and pass exact absolute arguments
# to the child on both native hosts. The workflow quotes each entire -D token.
foreach(path_variable IN ITEMS ANAIERO_BUILD_DIR ANAIERO_PROFILE ANAIERO_OUTPUT)
  if("${${path_variable}}" STREQUAL "")
    message(FATAL_ERROR "${path_variable} must not be empty")
  endif()
  get_filename_component(${path_variable} "${${path_variable}}" ABSOLUTE
    BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
endforeach()
if(NOT EXISTS "${ANAIERO_PROFILE}" OR IS_DIRECTORY "${ANAIERO_PROFILE}" OR IS_SYMLINK "${ANAIERO_PROFILE}")
  message(FATAL_ERROR "Qualification profile must be an existing regular file: ${ANAIERO_PROFILE}; quote the complete -DANAIERO_PROFILE=... argument in the invoking shell")
endif()
set(program ce_native_qualification)
if(WIN32)
  string(APPEND program .exe)
endif()
set(executable "${ANAIERO_BUILD_DIR}/${program}")
if(EXISTS "${ANAIERO_BUILD_DIR}/${ANAIERO_CONFIG}/${program}")
  set(executable "${ANAIERO_BUILD_DIR}/${ANAIERO_CONFIG}/${program}")
endif()
if(NOT EXISTS "${executable}")
  message(FATAL_ERROR "Build the native qualification executable first: ${executable}")
endif()
message(STATUS "Native qualification executable: ${executable}")
message(STATUS "Native qualification profile: ${ANAIERO_PROFILE}")
message(STATUS "Native qualification output: ${ANAIERO_OUTPUT}")
execute_process(COMMAND "${executable}" run "${ANAIERO_PROFILE}" "${ANAIERO_OUTPUT}"
  WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}" RESULT_VARIABLE result TIMEOUT 5400)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Native qualification failed or exceeded its declared limits: ${result}; inspect ${ANAIERO_OUTPUT}/report.json")
endif()
