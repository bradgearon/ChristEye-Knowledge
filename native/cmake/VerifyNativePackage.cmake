cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED ANAIERO_PACKAGE_DIR)
  message(FATAL_ERROR "Set ANAIERO_PACKAGE_DIR")
endif()
if(IS_SYMLINK "${ANAIERO_PACKAGE_DIR}" OR IS_SYMLINK "${ANAIERO_PACKAGE_DIR}/package-manifest.json")
  message(FATAL_ERROR "Package root and manifest must not be symlinks")
endif()
file(READ "${ANAIERO_PACKAGE_DIR}/package-manifest.json" manifest)
string(JSON schema GET "${manifest}" schema)
if(NOT schema STREQUAL "anaiero.native-package/1")
  message(FATAL_ERROR "Unsupported package manifest schema")
endif()
string(JSON expected_module GET "${manifest}" module_sha256)
string(JSON count LENGTH "${manifest}" files)
if(count LESS 1 OR count GREATER 100000)
  message(FATAL_ERROR "Package inventory count is outside its bound")
endif()
math(EXPR last "${count}-1")
set(expected)
foreach(index RANGE 0 ${last})
  string(JSON path GET "${manifest}" files ${index} path)
  if(path STREQUAL "" OR path MATCHES "(^|/)\\.\\.?(/|$)" OR IS_ABSOLUTE "${path}" OR path MATCHES "[;:\n\r\\\\]")
    message(FATAL_ERROR "Unsafe package manifest path")
  endif()
  string(REPLACE "/" ";" components "${path}")
  set(component_path "${ANAIERO_PACKAGE_DIR}")
  foreach(component IN LISTS components)
    string(APPEND component_path "/${component}")
    if(IS_SYMLINK "${component_path}")
      message(FATAL_ERROR "Package path traverses a symlink: ${path}")
    endif()
  endforeach()
  if(path IN_LIST expected OR IS_SYMLINK "${ANAIERO_PACKAGE_DIR}/${path}" OR NOT EXISTS "${ANAIERO_PACKAGE_DIR}/${path}")
    message(FATAL_ERROR "Missing, duplicate or symlink package entry: ${path}")
  endif()
  string(JSON expected_digest GET "${manifest}" files ${index} sha256)
  string(JSON expected_bytes GET "${manifest}" files ${index} bytes)
  file(SHA256 "${ANAIERO_PACKAGE_DIR}/${path}" digest)
  file(SIZE "${ANAIERO_PACKAGE_DIR}/${path}" bytes)
  if(NOT digest STREQUAL expected_digest OR NOT bytes EQUAL expected_bytes)
    message(FATAL_ERROR "Package bytes differ: ${path}")
  endif()
  list(APPEND expected "${path}")
endforeach()
file(GLOB_RECURSE actual RELATIVE "${ANAIERO_PACKAGE_DIR}" LIST_DIRECTORIES false "${ANAIERO_PACKAGE_DIR}/*")
file(GLOB_RECURSE entries RELATIVE "${ANAIERO_PACKAGE_DIR}" LIST_DIRECTORIES true "${ANAIERO_PACKAGE_DIR}/*")
foreach(entry IN LISTS entries)
  if(IS_SYMLINK "${ANAIERO_PACKAGE_DIR}/${entry}")
    message(FATAL_ERROR "Package contains an unverified symlink: ${entry}")
  endif()
endforeach()
list(REMOVE_ITEM actual package-manifest.json)
list(SORT actual)
list(SORT expected)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Package contains files outside its exact inventory")
endif()
set(host "${ANAIERO_PACKAGE_DIR}/bin/ce_modular_host")
if(WIN32)
  set(host "${host}.exe")
endif()
execute_process(COMMAND "${host}" package-info RESULT_VARIABLE result OUTPUT_VARIABLE host_info)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Installed host cannot run on this native system")
endif()
string(JSON module GET "${host_info}" module_sha256)
if(NOT module STREQUAL expected_module)
  message(FATAL_ERROR "Host compiled identity differs from the package manifest")
endif()
if(DEFINED ANAIERO_STORE_DIR)
  execute_process(COMMAND "${host}" check "${ANAIERO_STORE_DIR}" RESULT_VARIABLE compatible)
  if(NOT compatible EQUAL 0)
    message(FATAL_ERROR "Retained store is busy or incompatible; do not activate this package")
  endif()
endif()
message(STATUS "Native package inventory and executable identity verified")
