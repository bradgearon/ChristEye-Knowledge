if(NOT ANAIERO_BUILD_DIR OR NOT ANAIERO_CONSUMER_SOURCE)
  message(FATAL_ERROR "SDK consumer paths are required")
endif()
set(work "${ANAIERO_BUILD_DIR}/installed-sdk-conformance")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}/source")
file(COPY "${ANAIERO_CONSUMER_SOURCE}/" DESTINATION "${work}/source")
set(install_config)
set(consumer_config "${ANAIERO_TEST_CONFIG}")
if(ANAIERO_TEST_CONFIG)
  list(APPEND install_config --config "${ANAIERO_TEST_CONFIG}")
else()
  set(consumer_config Release)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${ANAIERO_BUILD_DIR}" --prefix "${work}/prefix"
  ${install_config} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "SDK installation failed (build all native targets first):\n${output}\n${error}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${work}/source" -B "${work}/build"
  "-DCMAKE_PREFIX_PATH=${work}/prefix" "-DCMAKE_BUILD_TYPE=${consumer_config}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Independent installed SDK configure failed:\n${output}\n${error}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${work}/build" --config "${consumer_config}" --parallel 2
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Independent installed SDK build failed:\n${output}\n${error}")
endif()
execute_process(COMMAND "${ANAIERO_CTEST}" --test-dir "${work}/build" -C "${consumer_config}" --output-on-failure
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Independent installed SDK execution failed:\n${output}\n${error}")
endif()
message(STATUS "Independent native/process engine compiled and executed using only the installed SDK")
